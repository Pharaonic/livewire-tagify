{
  "name": "pharaonic/livewire-tagify",
  "description": "Tagify for Livewire components: two-way wire:model binding for tags, select, and mix modes, on Livewire Assistant.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "livewire",
    "livewire-tagify",
    "tagify",
    "tags",
    "tag-input"
  ],
  "homepage": "https://pharaonic.dev/packages/livewire/tagify",
  "authors": [
    {
      "name": "Moamen Eltouny (Raggi)",
      "email": "raggigroup@gmail.com"
    }
  ],
  "support": {
    "docs": "https://pharaonic.dev/packages/livewire/tagify",
    "issues": "https://github.com/Pharaonic/livewire-tagify/issues",
    "source": "https://github.com/Pharaonic/livewire-tagify"
  },
  "require": {
    "php": ">=7.4 <8.0",
    "illuminate/http": "^7.30 || ^8.75",
    "illuminate/routing": "^7.30 || ^8.75",
    "illuminate/support": "^7.30 || ^8.75",
    "illuminate/view": "^7.30 || ^8.75",
    "livewire/livewire": ">=1.3.0 <1.3.7 || >=1.3.8 <2.0",
    "pharaonic/livewire-assistant": "^1.0"
  },
  "require-dev": {
    "orchestra/testbench": "^5.20 || ^6.25",
    "pestphp/pest": "^1.23",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^9.6.33"
  },
  "autoload": {
    "psr-4": {
      "Pharaonic\\Livewire\\Tagify\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pharaonic\\Livewire\\Tagify\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Pharaonic\\Livewire\\Tagify\\TagifyServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "@php vendor/bin/pest",
    "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
    "format": "@php tools/pint/vendor/bin/pint",
    "format:check": "@php tools/pint/vendor/bin/pint --test",
    "security": "@composer audit",
    "check": [
      "@composer validate --strict",
      "@analyse",
      "@test",
      "@security"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "audit": {
      "abandoned": "report"
    },
    "policy": {
      "advisories": {
        "block": false,
        "ignore": {
          "laravel/framework": "No fixed release within Laravel 7 or 8; the application chooses the framework release.",
          "league/commonmark": "No fixed release within Laravel 7; the application chooses the framework release.",
          "league/flysystem": "No fixed release within Laravel 7 or 8; the application chooses the framework release.",
          "livewire/livewire": "No fixed release within Livewire 1; the application chooses the Livewire release.",
          "zbateson/mail-mime-parser": "Development only, through orchestra/testbench and spatie/laravel-ray; no fixed release runs on PHP 7.4."
        }
      }
    },
    "sort-packages": true
  },
  "prefer-stable": true
}
