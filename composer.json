{
  "name": "pharaonic/livewire-tagify",
  "description": "Tagify for Livewire components: two-way wire:model binding for tags, select, and mix modes, on Livewire Assistant.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "livewire",
    "livewire-tagify",
    "tagify",
    "tags",
    "tag-input"
  ],
  "homepage": "https://pharaonic.dev/packages/livewire/tagify",
  "authors": [
    {
      "name": "Moamen Eltouny (Raggi)",
      "email": "raggigroup@gmail.com"
    }
  ],
  "support": {
    "docs": "https://pharaonic.dev/packages/livewire/tagify",
    "issues": "https://github.com/Pharaonic/livewire-tagify/issues",
    "source": "https://github.com/Pharaonic/livewire-tagify"
  },
  "require": {
    "php": ">=8.1 <8.6",
    "illuminate/http": "^10.16 || ^11.0 || ^12.0 || ^13.0",
    "illuminate/routing": "^10.16 || ^11.0 || ^12.0 || ^13.0",
    "illuminate/support": "^10.16 || ^11.0 || ^12.0 || ^13.0",
    "illuminate/view": "^10.16 || ^11.0 || ^12.0 || ^13.0",
    "livewire/livewire": "^4.3.4",
    "pharaonic/livewire-assistant": "^4.0"
  },
  "require-dev": {
    "laravel/pint": "^1.20",
    "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
    "pestphp/pest": "^1.23 || ^3.8 || ^4.0",
    "phpstan/phpstan": "^2.1.33",
    "phpunit/phpunit": "^9.6.33 || ^11.5.50 || ^12.5.8"
  },
  "autoload": {
    "psr-4": {
      "Pharaonic\\Livewire\\Tagify\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pharaonic\\Livewire\\Tagify\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Pharaonic\\Livewire\\Tagify\\TagifyServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "@php vendor/bin/pest",
    "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
    "format": "@php vendor/bin/pint",
    "format:check": "@php vendor/bin/pint --test",
    "security": "@composer audit",
    "check": [
      "@composer validate --strict",
      "@format:check",
      "@analyse",
      "@test",
      "@security"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "audit": {
      "abandoned": "report"
    },
    "policy": {
      "advisories": {
        "block": false,
        "ignore": {
          "laravel/framework": "No fixed release within Laravel 10 or 11; the application chooses the framework release."
        }
      }
    },
    "sort-packages": true
  },
  "prefer-stable": true
}
